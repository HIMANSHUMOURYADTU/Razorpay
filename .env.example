"""
LLM_PROVIDER=gemini
# One of: gemini | groq | ollama | anthropic
# This hackathon demo typically uses groq (openai/gpt-oss-20b).
# Switching providers does not change matching logic — only the model behind classify_match.

GEMINI_API_KEY=
# Required when LLM_PROVIDER=gemini.

GROQ_API_KEY=
# Required when LLM_PROVIDER=groq.

ANTHROPIC_API_KEY=
# Required when LLM_PROVIDER=anthropic. Not the free-tier option.

# GROQ_MODEL=openai/gpt-oss-20b
# Optional. Groq retired llama-3.1-8b-instant on free/dev tiers (Aug 2026).
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.2

LLM_CONFIDENCE_THRESHOLD=0.75
# LLM-proposed matches below this stay exceptions (reason attached). Never force-matched.
